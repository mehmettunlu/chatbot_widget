# LLM provider: "openai" or "groq"
LLM_PROVIDER=groq

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-replace-me
MODEL_NAME=gpt-4o-mini

# Groq (required if LLM_PROVIDER=groq) — free at console.groq.com
GROQ_API_KEY=gsk_replace-me
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Embeddings provider: "openai" or "huggingface" (huggingface is free, runs locally)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

CHROMA_PERSIST_DIR=./chroma_data
COLLECTION_NAME=documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
ALLOW_ORIGINS=*
